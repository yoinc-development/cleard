{
  "name": "cleard-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron shell for cleard",
  "main": "src/main.js",
  "scripts": {
    "dev": "cross-env CLEARD_BACKEND_URL=http://127.0.0.1:8080 electron .",
