<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="005-transactions-not-null" author="janes">
        <preConditions onFail="HALT"
                       onFailMessage="Cannot make transactions.category_id required: some transactions have no category (or a category that no longer exists). Assign them a category in the database, then start the app again.">
            <sqlCheck expectedResult="0">SELECT COUNT(*)
                                         FROM transactions
                                         WHERE category_id IS NULL</sqlCheck>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM transactions t
                         LEFT JOIN categories c ON c.id = t.category_id
                WHERE t.category_id IS NOT NULL
                  AND c.id IS NULL
            </sqlCheck>
        </preConditions>

        <createTable tableName="transactions_new">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tx_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_transactions_category_new"
                             references="categories(id)"/>
            </column>
        </createTable>

        <sql>
            INSERT INTO transactions_new (id, tx_date, amount, currency, description, category_id)
            SELECT id, tx_date, amount, currency, COALESCE(description, '(no description)'), category_id
            FROM transactions
        </sql>

        <dropTable tableName="transactions"/>
        <renameTable oldTableName="transactions_new" newTableName="transactions"/>
    </changeSet>

</databaseChangeLog>
