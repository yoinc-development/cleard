<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="006-create-accounts" author="janes">
        <createTable tableName="accounts">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="accounts">
            <column name="name" value="Default"/>
            <column name="icon" value="bank"/>
        </insert>

        <createTable tableName="transactions_new">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tx_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_transactions_category_v2"
                             references="categories(id)"/>
            </column>
            <column name="account_id" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_transactions_account"
                             references="accounts(id)"/>
            </column>
        </createTable>

        <sql>
            INSERT INTO transactions_new (id, tx_date, amount, currency, description, category_id, account_id)
            SELECT id,
                   tx_date,
                   amount,
                   currency,
                   description,
                   category_id,
                   (SELECT id FROM accounts WHERE name = 'Default' ORDER BY id LIMIT 1)
            FROM transactions
        </sql>

        <dropTable tableName="transactions"/>
        <renameTable oldTableName="transactions_new" newTableName="transactions"/>

        <createIndex tableName="transactions" indexName="idx_transactions_account_date">
            <column name="account_id"/>
            <column name="tx_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
